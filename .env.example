# ---- Copy this file to .env.local and fill in real values. NEVER commit .env.local ----

# Database (Supabase Postgres). Use the pooled "Connection string" for DATABASE_URL
# and the direct connection for DIRECT_URL (used by Prisma migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Google Maps
# Browser key: used client-side for Places autocomplete. Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Server key: used server-side for Distance Matrix. Restrict by API + IP, NOT referrer.
GOOGLE_MAPS_SERVER_KEY=""

# Resend (booking notification + customer confirmation emails)
RESEND_API_KEY=""
# Where booking notifications are sent (the operator's inbox)
BOOKING_NOTIFY_EMAIL="info@example.de"
# The verified "from" address for outgoing mail
BOOKING_FROM_EMAIL="no-reply@example.de"

# Admin panel (single admin). Change these before deploying.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# Random 32+ char string used to sign the admin session cookie.
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://example.de"
